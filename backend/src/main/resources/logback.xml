<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%date{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC}","level":"%level","logger":"%logger{36}","message":"%replace(%msg){'([\\"\\])','\\$1'}"}%n</pattern>
        </encoder>
    </appender>
    <logger name="io.netty" level="WARN" />
    <logger name="org.sqlite" level="WARN" />
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
