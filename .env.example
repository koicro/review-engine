# Copy to .env and replace this value before starting Compose.
REVIEW_ADMIN_TOKEN=replace-with-a-long-random-secret
REVIEW_HTTP_PORT=8080
REVIEW_UI_ENABLED=true
# Pictures share the persistent /data volume with SQLite by default.
# REVIEW_PICTURE_PATH=/data/review-pictures
# Set this to the browser-facing origin (without a path) when TLS or a reverse proxy is used.
# REVIEW_PUBLIC_ORIGIN=https://reviews.example.com
